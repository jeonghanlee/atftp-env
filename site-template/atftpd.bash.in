#!/bin/bash -p

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset BASH_ENV ENV
umask 022

readonly SERVICE=@SYSTEMD_FILENAME@
readonly SOCKET=@SYSTEMD_SOCKET@
declare -a SYSTEMCTL=(systemctl)
if (( EUID != 0 )); then
    SYSTEMCTL=(sudo systemctl)
fi

case "${1:-help}" in
    start)
        "${SYSTEMCTL[@]}" start "$SOCKET"
        ;;
    stop)
        "${SYSTEMCTL[@]}" stop "$SOCKET" "$SERVICE"
        ;;
    restart|reload)
        "${SYSTEMCTL[@]}" stop "$SOCKET" "$SERVICE"
        "${SYSTEMCTL[@]}" start "$SOCKET"
        ;;
    status)
        exec systemctl status "$SOCKET" "$SERVICE"
        ;;
    h|help|--help)
        printf 'Usage: %s {start|stop|restart|reload|status}\n' "$0"
        ;;
    *)
        printf 'Unknown command: %s\n' "$1" >&2
        exit 2
        ;;
esac
